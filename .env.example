# Copy to .env and fill in. Never commit .env.

# MongoDB — local, or a MongoDB Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=palleturi

PORT=3000
TABLE_COUNT=12
CAFE_TIMEZONE=Asia/Kolkata
# Hour (24h, cafe time) for the nightly report. 22 = 10 PM.
REPORT_HOUR=22

# PINs used only the first time the database is created (change later in Settings).
OWNER_PIN=1234
STAFF_PIN=0000

# Optional: automatic nightly WhatsApp via Meta's WhatsApp Business Cloud API.
# Leave empty to use the one-tap "Send to WhatsApp" reminder instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Approved template name with one body variable {{1}} (needed for messages the
# business starts). Leave empty to send plain text (only works inside 24h windows).
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
